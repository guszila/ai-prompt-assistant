# ==============================================
# AI Engineering Assistant - Environment Config
# ==============================================

# AI Service Configuration
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
AI_SERVICE_LOG_LEVEL=info

# Desktop App Frontend
VITE_AI_SERVICE_URL=http://127.0.0.1:8000

# Local Embedded Database (SQLite)
# Stored locally on the user's system without external database servers or Docker
SQLITE_DB_PATH=data/app.db

# LLM Providers (Placeholder - Provider-agnostic abstraction in M1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOCAL_LLM_URL=http://127.0.0.1:11434
